{
  "$schema": "https://raw.githubusercontent.com/nicedoc/tauri/dev/.schema/config.schema.json",
  "productName": "YiziMarkdown",
  "version": "0.3.7",
  "identifier": "com.yizimarkdown.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "YiziMarkdown",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "resources": {
      "themes/*": "themes/",
      "templates": "templates/",
      "skills": "skills/",
      "docs": "docs/",
      "user.css": "user.css",
      "keybindings.json": "keybindings.json",
      "readme.md": "readme.md",
      "welcome.md": "welcome.md",
      "icons/md-icon.ico": "md-icon.ico",
      "help.md": "help.md",
      "skill-guide.md": "skill-guide.md"
    },
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installerHooks": "installer.nsh",
        "displayLanguageSelector": false,
        "languages": ["SimpChinese", "English"]
      },
      "wix": {
        "language": "zh-CN"
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "md"
        ],
        "name": "Markdown File",
        "description": "Markdown Document"
      }
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM1NzJFNEYwODdDRThGREMKUldUY2o4Nkg4T1J5TlR4cnlaS1VKc054eE5iQW9BSHF0VmkrYldEbzFRRTZEbHN1Sm96ank1TUsK",
      "endpoints": [
        "https://github.com/laoduu/YiziMarkdown/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}